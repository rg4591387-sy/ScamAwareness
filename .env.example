# ScamShield AI 2.0 Environment Configuration
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file to version control.

# Port for the Express backend server
PORT=5000

# Server Node Environment (development | production)
NODE_ENV=development

# Google Gemini API Key
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# If left empty, ScamShield AI will operate in Demo Mode with built-in educational analysis.
GEMINI_API_KEY=

# Gemini Model Identifier
# Default recommended: gemini-2.5-flash or gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Frontend URL for CORS (in development, typically http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Database configuration (optional - defaults to local file/sqlite repository)
# DATABASE_URL=postgresql://user:password@localhost:5432/scamshield
